# Core Ollama configuration (safe repository defaults)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
MODEL_NAME=gemma3:4b
NUM_CTX=8192
NUM_THREAD=4
NUM_GPU=-1
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=512
KEEP_ALIVE=30m

# Web server. HERMES_WEB_TOKEN is mandatory when WEB_HOST is not loopback.
WEB_HOST=127.0.0.1
WEB_PORT=8080
HERMES_WEB_TOKEN=
HERMES_DB_PATH=data/chat_bth.db
HERMES_WORKSPACE_ROOT=data/workspaces

# Command execution is disabled unless explicitly enabled.
HERMES_ENABLE_COMMANDS=false
HERMES_RUN_COMMANDS=python,python3,node,npm,pytest

# Optional Telegram integration. Never commit real values.
TELEGRAM_TOKEN=
MY_USER_ID=0

# Optional local voice integration.
HERMES_PIPER_MODEL=
HERMES_PIPER_MODEL_TH=
HERMES_PUSH_TO_TALK_KEYS=5+6
