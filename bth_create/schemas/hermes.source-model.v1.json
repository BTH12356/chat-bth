{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes.source-model/v1",
  "title": "Hermes Project Source Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "name", "source_of_truth", "revision", "pages", "theme", "assets", "updated_at"],
  "properties": {
    "schema": {"const": "hermes.source-model/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "source_of_truth": {"enum": ["html-css-js", "component-model"]},
    "revision": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "theme": {"$ref": "#/$defs/theme"},
    "assets": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "tag", "path", "attributes", "styles", "children"], "properties": {"id": {"type": "string", "pattern": "^node-[0-9a-f]{16}$"}, "kind": {"type": "string"}, "tag": {"type": "string"}, "path": {"type": "string"}, "attributes": {"type": "object"}, "styles": {"type": "object"}, "content": {"type": ["string", "null"]}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}},
    "page": {"type": "object", "additionalProperties": false, "required": ["id", "path", "title", "root"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "title": {"type": "string"}, "root": {"$ref": "#/$defs/node"}}},
    "theme": {"type": "object", "additionalProperties": false, "required": ["id", "tokens"], "properties": {"id": {"type": "string"}, "tokens": {"type": "object"}}}
  }
}
