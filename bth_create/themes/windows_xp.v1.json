{
  "id": "windows_xp.v1",
  "version": "1.0.0",
  "name": "Windows XP",
  "description": "A compact classic desktop theme with blue title bars, beveled controls, and clear active states.",
  "typography": {"font_family": "Tahoma, sans-serif", "font_size": "12px", "font_weight": "400", "line_height": "1.25"},
  "colors": {"desktop": "#3A6EA5", "surface": "#ECE9D8", "surface_alt": "#FFFFFF", "text": "#000000", "muted_text": "#666666", "accent": "#316AC5", "accent_dark": "#0A246A", "danger": "#C00000"},
  "borders": {"width": "1px", "style": "solid", "light": "#FFFFFF", "mid": "#ACA899", "dark": "#716F64", "radius": "2px"},
  "window_chrome": {"background": "#ECE9D8", "shadow": "2px 2px 0 #404040", "padding": "3px"},
  "title_bars": {"active": "linear-gradient(#0A246A, #3A6EA5)", "inactive": "linear-gradient(#7F9DB9, #B5C7D8)", "text": "#FFFFFF", "height": "22px"},
  "buttons": {"background": "#ECE9D8", "border": "outset", "padding": "3px 10px", "min_height": "22px"},
  "inputs": {"background": "#FFFFFF", "border": "inset", "padding": "3px 4px", "min_height": "22px"},
  "menus": {"background": "#FFFFFF", "hover": "#316AC5", "text": "#000000", "hover_text": "#FFFFFF"},
  "taskbar": {"background": "linear-gradient(#245DDA, #1941A5)", "height": "30px", "text": "#FFFFFF"},
  "spacing": {"xs": "2px", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px"},
  "icons": {"size": "16px", "active_filter": "none", "disabled_opacity": "0.5"},
  "hover_states": {"background": "#D6E8FF", "border": "#316AC5", "text": "#000000"},
  "active_states": {"background": "#316AC5", "border": "#0A246A", "text": "#FFFFFF"},
  "disabled_states": {"background": "#ECE9D8", "text": "#ACA899", "opacity": "0.7"},
  "panel_styles": {"background": "#ECE9D8", "border": "inset", "padding": "8px"},
  "dialog_styles": {"background": "#ECE9D8", "border": "outset", "padding": "10px", "min_width": "320px"},
  "component_recipes": {
    "window": {"component": "window", "base": {"chrome": "window_chrome", "title": "title_bars.active"}, "states": {"inactive": {"title": "title_bars.inactive"}}},
    "button": {"component": "button", "base": {"style": "buttons"}, "states": {"hover": {"style": "hover_states"}, "active": {"style": "active_states"}, "disabled": {"style": "disabled_states"}}},
    "checkbox": {"component": "checkbox", "base": {"style": "inputs"}, "states": {"checked": {"style": "active_states"}, "disabled": {"style": "disabled_states"}}},
    "radio": {"component": "radio", "base": {"style": "inputs"}, "states": {"checked": {"style": "active_states"}, "disabled": {"style": "disabled_states"}}},
    "select": {"component": "select", "base": {"style": "inputs"}, "states": {"open": {"style": "menus"}, "disabled": {"style": "disabled_states"}}},
    "input": {"component": "input", "base": {"style": "inputs"}, "states": {"focus": {"border": "active_states"}, "disabled": {"style": "disabled_states"}}},
    "panel": {"component": "panel", "base": {"style": "panel_styles"}, "states": {}},
    "dialog": {"component": "dialog", "base": {"style": "dialog_styles"}, "states": {}},
    "toolbar": {"component": "toolbar", "base": {"style": "panel_styles", "spacing": "spacing.sm"}, "states": {}},
    "statusbar": {"component": "statusbar", "base": {"style": "panel_styles", "height": "22px"}, "states": {}},
    "taskbar": {"component": "taskbar", "base": {"style": "taskbar"}, "states": {}},
    "table": {"component": "table", "base": {"style": "panel_styles", "header": "active_states"}, "states": {"row_hover": {"style": "hover_states"}}},
    "card": {"component": "card", "base": {"style": "panel_styles"}, "states": {"hover": {"style": "hover_states"}}}
  }
}
