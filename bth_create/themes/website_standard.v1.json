{
  "id":"website_standard.v1","version":"1.0.0","name":"Standard Website","description":"Responsive website foundation whose accent palette is selected from Project Spec appearance.",
  "typography":{"font_family":"Inter, system-ui, sans-serif","font_size":"16px","font_weight":"400","line_height":"1.6"},
  "colors":{"desktop":"#f8fafc","surface":"#ffffff","surface_alt":"#f1f5f9","text":"#0f172a","muted_text":"#64748b","accent":"#2563eb","accent_dark":"#1d4ed8","danger":"#dc2626"},
  "borders":{"width":"1px","style":"solid","light":"#e2e8f0","mid":"#cbd5e1","dark":"#94a3b8","radius":"14px"},
  "window_chrome":{"background":"#ffffff","shadow":"0 20px 50px rgba(15,23,42,.08)","padding":"0"},
  "title_bars":{"active":"#ffffff","inactive":"#f8fafc","text":"#0f172a","height":"64px"},
  "buttons":{"background":"accent","border":"none","padding":"10px 16px","min_height":"42px"},
  "inputs":{"background":"#ffffff","border":"#cbd5e1","padding":"10px 12px","min_height":"42px"},
  "menus":{"background":"#ffffff","hover":"#eff6ff","text":"#0f172a","hover_text":"#1d4ed8"},
  "taskbar":{"background":"#ffffff","height":"64px","text":"#0f172a"},
  "spacing":{"xs":"4px","sm":"8px","md":"16px","lg":"24px","xl":"40px"},
  "icons":{"size":"20px","active_filter":"none","disabled_opacity":"0.5"},
  "hover_states":{"background":"#eff6ff","border":"#93c5fd","text":"#1d4ed8"},
  "active_states":{"background":"#2563eb","border":"#1d4ed8","text":"#ffffff"},
  "disabled_states":{"background":"#e2e8f0","text":"#94a3b8","opacity":"0.65"},
  "panel_styles":{"background":"#ffffff","border":"#e2e8f0","padding":"24px"},
  "dialog_styles":{"background":"#ffffff","border":"#e2e8f0","padding":"24px","min_width":"320px"},
  "component_recipes":{
    "window":{"component":"window","base":{"style":"window_chrome"},"states":{}},
    "button":{"component":"button","base":{"style":"buttons"},"states":{"hover":{"style":"hover_states"},"disabled":{"style":"disabled_states"}}},
    "checkbox":{"component":"checkbox","base":{"style":"inputs"},"states":{"disabled":{"style":"disabled_states"}}},
    "radio":{"component":"radio","base":{"style":"inputs"},"states":{"disabled":{"style":"disabled_states"}}},
    "select":{"component":"select","base":{"style":"inputs"},"states":{"open":{"style":"menus"}}},
    "input":{"component":"input","base":{"style":"inputs"},"states":{"focus":{"style":"active_states"}}},
    "panel":{"component":"panel","base":{"style":"panel_styles"},"states":{}},
    "dialog":{"component":"dialog","base":{"style":"dialog_styles"},"states":{}},
    "toolbar":{"component":"toolbar","base":{"style":"taskbar"},"states":{}},
    "statusbar":{"component":"statusbar","base":{"style":"taskbar"},"states":{}},
    "taskbar":{"component":"taskbar","base":{"style":"taskbar"},"states":{}},
    "table":{"component":"table","base":{"style":"panel_styles"},"states":{"row_hover":{"style":"hover_states"}}},
    "card":{"component":"card","base":{"style":"panel_styles"},"states":{"hover":{"style":"hover_states"}}}
  }
